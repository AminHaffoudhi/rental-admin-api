# Copy to .env

NODE_ENV=development
SERVICE_NAME=rental-admin-api
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Same database as rental-api
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/rental"

JWT_SECRET="generate_a_long_random_string"
JWT_EXPIRES_IN="7d"
PORT=4001
ADMIN_CLIENT_URL="http://localhost:5175"
CLIENT_URL="http://localhost:5174"

# Gmail SMTP (2FA + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your_app_password_here

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional: REDIS_PASSWORD=

# OneSignal — MUST be the same app as rental-api / rental-web VITE_ONESIGNAL_APP_ID
# ONESIGNAL_APP_ID=c558d024-77bf-4892-95f3-e293eefe8380
# ONESIGNAL_REST_API_KEY=

# Cloudinary — same credentials as rental-api/.env
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=rentmarket
UPLOAD_MAX_IMAGE_MB=10
